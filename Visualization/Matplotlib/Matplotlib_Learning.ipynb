    "\n",
    "ax.plot([10, 20, 30, 40, 50], [25, 18, 30, 22, 35],\n",
    "        color = \"red\",\n",
    "        linestyle = \":\",\n",
    "        linewidth = 2 ,\n",
    "        marker = \"^\")\n",
