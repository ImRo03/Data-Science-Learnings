   "source": [
    "import pandas as pd \n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "fig,ax = plt.subplots()\n",
    "\n",
    "ax.plot([10, 20, 30, 40, 50], [25, 18, 30, 22, 35],\n",
    "        color = \"blue\",\n",
    "        linestyle = \":\")\n",
    "\n",
    "ax.set_title(\"W-shape line chart\")\n",
    "ax.set_xlabel(\"X Value\")\n",
    "ax.set_ylabel(\"Y Value\")\n",
    "\n",
    "plt.show()\n",
    "             \n"
   ]
  },
